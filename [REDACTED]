enum class SearchScope(val labelRes: Int) {
    ALL(io.github.submark.feature.overview.R.string.search_scope_all),
    SUBSCRIPTIONS(io.github.submark.feature.overview.R.string.search_scope_subscriptions),
    PAYMENTS(io.github.submark.feature.overview.R.string.search_scope_payments),
    CATEGORIES(io.github.submark.feature.overview.R.string.search_scope_categories),
}

sealed interface SearchResult {
    val id: String
    val title: String
    val subtitle: String?
    val iconType: io.github.submark.core.model.IconType?
    val iconValue: String?

    data class SubscriptionRow(
        val subscription: Subscription,
        override val title: String,
        override val subtitle: String?,
        override val iconType: io.github.submark.core.model.IconType?,
        override val iconValue: String?,
    ) : SearchResult {
        override val id: String get() = subscription.id
    }

    data class PaymentRow(
        val record: PaymentRecord,
        val subscription: Subscription?,
        val currencySymbol: String?,
        override val title: String,
        override val subtitle: String?,
        override val iconType: io.github.submark.core.model.IconType?,
        override val iconValue: String?,
    ) : SearchResult {
        override val id: String get() = record.id
    }

    data class CategoryRow(
        val id: String,
        override val title: String,
        override val subtitle: String?,
        override val iconType: io.github.submark.core.model.IconType?,
        override val iconValue: String?,
        val isCustom: Boolean,
    ) : SearchResult
}

data class GlobalSearchUiState(
    val query: String = "",
    val scope: SearchScope = SearchScope.ALL,
    val isSearching: Boolean = false,
    val recentSearches: List<String> = emptyList(),
    val results: List<SearchResult> = emptyList(),
    val hasQuery: Boolean = false,
    val showTips: Boolean = true,
)

@HiltViewModel
class GlobalSearchViewModel @Inject constructor(
    private val subscriptions: SubscriptionRepository,
    private val categories: CategoryRepository,
    private val paymentMethods: PaymentMethodRepository,
    private val payments: PaymentService,
    private val shared: SharedService,
    private val settings: SettingsRepository,
    private val time: TimeProvider,
) : ViewModel() {

    private val queryFlow = MutableStateFlow("")
    private val scopeFlow = MutableStateFlow(SearchScope.ALL)
    private val isSearchingFlow = MutableStateFlow(false)
    private val resultFlow = MutableStateFlow<List<SearchResult>>(emptyList())

    private val snackbarChannel = Channel<SnackbarMessage>(Channel.BUFFERED)
    val snackbars: Flow<SnackbarMessage> = snackbarChannel.receiveAsFlow()

    val uiState: StateFlow<GlobalSearchUiState> = combine(
        queryFlow,
        scopeFlow,
        settings.settings.map { it.search.recentSearches },
        isSearchingFlow,
        resultFlow,
    ) { query, scope, recent, isSearching, results ->
        GlobalSearchUiState(
            query = query,
            scope = scope,
            isSearching = isSearching,
            recentSearches = recent,
            results = results,
            hasQuery = query.isNotBlank(),
            showTips = query.isBlank(),
        )
    }.stateIn(viewModelScope, kotlinx.coroutines.flow.SharingStarted.WhileSubscribed(5_000), GlobalSearchUiState())

    init {
        viewModelScope.launch {
            queryFlow.debounce(250)
                .flatMapLatest { query ->
                    if (query.isBlank()) {
                        isSearchingFlow.value = false
                        resultFlow.value = emptyList()
                        return@flatMapLatest kotlinx.coroutines.flow.flowOf(Unit)
                    }
                    isSearchingFlow.value = true
                    val results = runSearch(query, scopeFlow.value)
                    resultFlow.value = results
                    isSearchingFlow.value = false
                    kotlinx.coroutines.flow.flowOf(Unit)
                }
                .collect {}
        }
    }

    private fun runSearch(query: String, scope: SearchScope): kotlinx.coroutines.flow.Flow<List<SearchResult>> {
        val q = query.trim()
        return when (scope) {
            SearchScope.SUBSCRIPTIONS -> subscriptions.observeAll().map { subs -> toSubscriptionRows(q, subs) }
            SearchScope.PAYMENTS -> combine(
                subscriptions.observeAll(),
                payments.observeAll(),
            ) { subs, pays -> toPaymentRows(q, subs, pays) }
            SearchScope.CATEGORIES -> categories.observeAll().map { cats -> toCategoryRows(q, cats) }
            SearchScope.ALL -> combine(
                subscriptions.observeAll(),
                payments.observeAll(),
                categories.observeAll(),
            ) { subs, pays, cats ->
                toSubscriptionRows(q, subs) + toPaymentRows(q, subs, pays) + toCategoryRows(q, cats)
            }
        }
    }

    private suspend fun toSubscriptionRows(query: String, subs: List<Subscription>): List<SearchResult.SubscriptionRow> {
        val q = query.lowercase()
        return subs
            .filter { sub ->
                sub.kind != SubscriptionKind.WISHLIST &&
                    (sub.name.lowercase().contains(q) ||
                        sub.note?.lowercase()?.contains(q) == true ||
                        sub.website?.lowercase()?.contains(q) == true ||
                        sub.price.toString().contains(q) ||
                        sub.currencyCode.lowercase() == q)
            }
            .sortedWith(compareBy<Subscription> { !it.name.lowercase().startsWith(q) }.thenBy { it.name.lowercase() })
            .map { sub ->
                SearchResult.SubscriptionRow(
                    subscription = sub,
                    title = sub.name,
                    subtitle = sub.note ?: "${sub.currencyCode} ${sub.price}",
                    iconType = sub.iconType,
                    iconValue = sub.iconValue,
                )
            }
    }

    private fun toPaymentRows(query: String, subs: List<Subscription>, pays: List<PaymentRecord>): List<SearchResult.PaymentRow> {
        val q = query.lowercase()
        val subById = subs.associateBy { it.id }
        return pays
            .filter { record ->
                record.status == PaymentStatus.SUCCESS &&
                    record.kind != PaymentKind.EXTENSION &&
                    record.amount.toString().contains(q) ||
                    record.note?.lowercase()?.contains(q) == true ||
                    record.paymentDate.toString().contains(q) ||
                    (subById[record.subscriptionId]?.name?.lowercase()?.contains(q) == true)
            }
            .sortedBy { it.paymentDate }
            .reversed()
            .take(30)
            .map { record ->
                val sub = subById[record.subscriptionId]
                SearchResult.PaymentRow(
                    record = record,
                    subscription = sub,
                    currencySymbol = null,
                    title = sub?.name ?: "Unknown subscription",
                    subtitle = "${record.paymentDate} · ${record.currencyCode} ${record.amount}",
                    iconType = sub?.iconType,
                    iconValue = sub?.iconValue,
                )
            }
    }

    private fun toCategoryRows(query: String, cats: List<io.github.submark.core.model.Category>): List<SearchResult.CategoryRow> {
        val q = query.lowercase()
        return cats
            .filter { cat ->
                cat.name?.lowercase()?.contains(q) == true ||
                    cat.systemKey?.name?.lowercase()?.contains(q) == true ||
                    cat.systemKey?.let { io.github.submark.core.ui.format.SystemCategory.valueOf(it.name) != null } == true
            }
            .map { cat ->
                SearchResult.CategoryRow(
                    id = cat.id,
                    title = cat.name ?: (cat.systemKey?.name ?: "Category"),
                    subtitle = cat.systemKey?.name ?: "Custom",
                    iconType = androidx.room.Room.escapePath(io.github.submark.core.model.IconType.SYMBOL, cat.iconValue),
                    iconValue = cat.iconValue,
                    isCustom = cat.systemKey == null,
                )
            }
    }

    fun onQueryChange(q: String) {
        queryFlow.value = q
    }

    fun onScopeChange(scope: SearchScope) {
        scopeFlow.value = scope
        if (queryFlow.value.isNotBlank()) {
            viewModelScope.launch { runAndStore(queryFlow.value, scope) }
        }
    }

    private suspend fun runAndStore(query: String, scope: SearchScope) {
        isSearchingFlow.value = true
        viewModelScope.async {
            runSearch(query, scope).map { it }.collect { resultFlow.value = it }
        }.await()
        isSearchingFlow.value = false
    }

    fun onRecentQueryClick(query: String) {
        queryFlow.value = query
    }

    fun onClearRecent() {
        viewModelScope.launch {
            settings.update {
                it.copy(search = it.search.copy(recentSearches = emptyList()))
            }
        }
    }

    fun onResultClick(result: SearchResult, onNavigate: (target: SearchNavigationTarget) -> Unit) {
        when (result) {
            is SearchResult.SubscriptionRow -> {
                addRecent(queryFlow.value)
                onNavigate(SearchNavigationTarget.Subscription(result.subscription))
            }
            is SearchResult.PaymentRow -> {
                addRecent(queryFlow.value)
                onNavigate(SearchNavigationTarget.Payment(result.record))
            }
            is SearchResult.CategoryRow -> {
                addRecent(queryFlow.value)
                onNavigate(SearchNavigationTarget.Category(result.id))
            }
        }
    }

    private fun addRecent(query: String) {
        if (query.isBlank()) return
        viewModelScope.launch {
            settings.update {
                val existing = it.search.recentSearches.toMutableList()
                existing.remove(query)
                existing.add(0, query)
                val capped = existing.take(io.github.submark.core.data.settings.SearchSettings.MAX_RECENT)
                it.copy(search = it.search.copy(recentSearches = capped))
            }
        }
    }

    sealed interface SearchNavigationTarget {
        data class Subscription(val sub: io.github.submark.core.model.Subscription) : SearchNavigationTarget
        data class Payment(val record: PaymentRecord) : SearchNavigationTarget
        data class Category(val id: String) : SearchNavigationTarget
    }
}
